{
  "expo": {
    "name": "LinguaForge",
    "slug": "linguaforge",
    "scheme": "linguaforge",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": { "typedRoutes": false },
    "ios": { "supportsTablet": true, "bundleIdentifier": "app.linguaforge.mobile" },
    "android": { "package": "app.linguaforge.mobile" }
  }
}
