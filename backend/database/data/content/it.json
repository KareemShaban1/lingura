 "topics": [
  {
   "slug": "essere_present",
   "level": "A1",
   "title": {
    "en": "The verb essere (present)",
    "ar": "الفعل essere في المضارع"
   },
   "explanation": {
    "en": "Use essere to say who someone is, where they are from and to describe them. Forms: io sono, tu sei, lui/lei è, noi siamo, voi siete, loro sono.",
    "ar": "يُستخدم الفعل essere للتعريف بالشخص وبلده ووصفه. تصريفه: io sono، tu sei، lui/lei è، noi siamo، voi siete، loro sono."
   },
   "examples": [
    [
     "Sono di Roma.",
     "I am from Rome."
    ],
    [
     "Lei è medico.",
     "She is a doctor."
    ],
    [
     "Siamo amici.",
     "We are friends."
    ]
   ]
  },
  {
   "slug": "article_gender",
   "level": "A1",
   "title": {
    "en": "Articles and gender",
    "ar": "أدوات التعريف والتذكير والتأنيث"
   },
   "explanation": {
    "en": "Italian nouns are masculine (often -o) or feminine (often -a). Masculine: il/un, lo/uno before s+consonant or z. Feminine: la/una. Plural: i/gli (masculine), le (feminine).",
    "ar": "الأسماء الإيطالية مذكرة (غالبًا تنتهي بـ -o) أو مؤنثة (غالبًا تنتهي بـ -a). للمذكر: il/un، وlo/uno قبل s مع ساكن أو z. للمؤنث: la/una. وفي الجمع: i/gli للمذكر وle للمؤنث."
   },
   "examples": [
    [
     "il libro",
     "the book"
    ],
    [
     "la casa",
     "the house"
    ],
    [
     "i tavoli",
     "the tables"
    ]
   ]
  },
  {
   "slug": "present_are",
   "level": "A1",
   "title": {
    "en": "Present tense of -are verbs",
    "ar": "المضارع للأفعال المنتهية بـ -are"
   },
   "explanation": {
    "en": "Remove -are and add -o, -i, -a, -iamo, -ate, -ano. Parlare → parlo, parli, parla, parliamo, parlate, parlano.",
    "ar": "احذف -are وأضف -o، -i، -a، -iamo، -ate، -ano. مثال: parlare ← parlo، parli، parla، parliamo، parlate، parlano."
   },
   "examples": [
    [
     "Parlo italiano.",
     "I speak Italian."
    ],
    [
     "Lavori qui?",
     "Do you work here?"
    ],
    [
     "Studiano molto.",
     "They study a lot."
    ]
   ]
  },
  {
   "slug": "piacere",
   "level": "A1",
   "title": {
    "en": "Saying what you like with piacere",
    "ar": "التعبير عمّا تحبه بالفعل piacere"
   },
   "explanation": {
    "en": "Piacere agrees with the thing that is liked: mi piace + singular noun or verb, mi piacciono + plural noun. The person is shown with mi, ti, gli/le, ci, vi, gli.",
    "ar": "يتطابق الفعل piacere مع الشيء المحبوب: mi piace مع المفرد أو الفعل، وmi piacciono مع الجمع. ويُعبَّر عن الشخص بـ mi وti وgli/le وci وvi وgli."
   },
   "examples": [
    [
     "Mi piace il caffè.",
     "I like coffee."
    ],
    [
     "Ci piacciono i libri.",
     "We like books."
    ],
    [
     "Ti piace ballare?",
     "Do you like dancing?"
    ]
   ]
  }
 ],
