 "language": "ar",
 "topics": [
  {
   "slug": "negation_past_future",
   "level": "B1",
   "title": {
    "en": "Negating the past and the future",
    "ar": "نفي الماضي والمستقبل"
   },
   "explanation": {
    "en": "Negate the past with لم + the jussive present (لم أذهبْ) or ما + past (ما ذهبتُ). Express the future with سـ or سوف + present (سأسافر) and negate it with لن + the subjunctive present (لن أسافرَ).",
    "ar": "يُنفى الماضي بـ «لم» + المضارع المجزوم (لم أذهبْ) أو «ما» + الماضي (ما ذهبتُ). ويُعبَّر عن المستقبل بـ «سـ» أو «سوف» + المضارع (سأسافر)، ويُنفى بـ «لن» + المضارع المنصوب (لن أسافرَ)."
   },
   "examples": [
    [
     "لم أذهب إلى العمل أمس.",
     "I didn't go to work yesterday."
    ],
    [
     "سأسافر إلى عمّان الأسبوع القادم.",
     "I will travel to Amman next week."
    ],
    [
     "لن أتأخر مرة أخرى.",
     "I won't be late again."
    ]
   ]
  },
  {
   "slug": "kana_past_continuous",
   "level": "B1",
   "title": {
    "en": "كان for past descriptions and habits",
    "ar": "«كان» لوصف الماضي والعادات"
   },
   "explanation": {
    "en": "Use كان + present to describe habits or ongoing actions in the past: كنتُ أدرسُ كل مساء (I used to study every evening). كان agrees with the subject: كانت تعمل، كانوا يلعبون.",
    "ar": "تُستخدم «كان» + المضارع لوصف العادات أو الأفعال المستمرة في الماضي: كنتُ أدرسُ كل مساء. وتتطابق «كان» مع الفاعل: كانت تعمل، كانوا يلعبون."
   },
   "examples": [
    [
     "كنتُ أسكن في القاهرة عندما كنتُ صغيرًا.",
     "I used to live in Cairo when I was young."
    ],
    [
     "كانت تقرأ عندما رنّ الهاتف.",
     "She was reading when the phone rang."
    ],
    [
     "كانوا يلعبون في الحديقة كل يوم.",
     "They used to play in the park every day."
    ]
   ]
  },
  {
   "slug": "advice_should",
   "level": "B1",
   "title": {
    "en": "Giving advice: يجب أن and ينبغي أن",
    "ar": "تقديم النصيحة: يجب أن وينبغي أن"
   },
   "explanation": {
    "en": "Give advice or express obligation with يجب أن / ينبغي أن / عليك أن + subjunctive present: يجب أن تنامَ أكثر، عليك أن تزورَ الطبيب. For politeness: من الأفضل أن…",
    "ar": "قدّم النصيحة أو عبّر عن الوجوب بـ «يجب أن / ينبغي أن / عليك أن» + المضارع المنصوب: يجب أن تنامَ أكثر، عليك أن تزورَ الطبيب. وللتلطيف: من الأفضل أن…"
   },
   "examples": [
    [
     "يجب أن تشرب ماءً أكثر.",
     "You must drink more water."
    ],
    [
     "ينبغي أن نصل مبكرًا.",
     "We should arrive early."
    ],
    [
     "من الأفضل أن تسأل المعلم.",
     "It's better to ask the teacher."
    ]
   ]
  },
  {
   "slug": "relative_pronouns",
   "level": "B1",
   "title": {
    "en": "Relative pronouns الذي والتي والذين",
    "ar": "الأسماء الموصولة: الذي والتي والذين"
   },
   "explanation": {
    "en": "Use a relative pronoun after a definite noun, matching its gender and number: الرجلُ الذي يسكن بجانبنا، المدينةُ التي وُلدتُ فيها، الطلابُ الذين نجحوا. After an indefinite noun, no relative pronoun is used: رأيتُ فيلمًا أعجبني.",
    "ar": "يأتي الاسم الموصول بعد الاسم المعرفة مطابقًا له في الجنس والعدد: الرجلُ الذي يسكن بجانبنا، المدينةُ التي وُلدتُ فيها، الطلابُ الذين نجحوا. وبعد النكرة لا يُستخدم اسم موصول: رأيتُ فيلمًا أعجبني."
   },
   "examples": [
    [
     "هذا هو الرجل الذي ساعدني.",
     "This is the man who helped me."
    ],
    [
     "المدينة التي أسكن فيها صغيرة.",
     "The town where I live is small."
    ],
    [
     "الطلاب الذين درسوا نجحوا.",
     "The students who studied passed."
    ]
   ]
  }
 ],
