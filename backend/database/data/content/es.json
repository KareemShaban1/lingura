 "language": "es",
 "topics": [
  {
   "slug": "ser_present",
   "level": "A1",
   "title": {
    "en": "The verb ser (present)",
    "ar": "الفعل ser في المضارع"
   },
   "explanation": {
    "en": "Use ser to say who someone is, where they are from and to describe lasting characteristics. Forms: yo soy, tú eres, él/ella/usted es, nosotros somos, vosotros sois, ellos/ustedes son.",
    "ar": "يُستخدم الفعل ser للتعريف بالشخص وبلده وبالصفات الدائمة. تصريفه: yo soy، tú eres، él/ella/usted es، nosotros somos، vosotros sois، ellos/ustedes son."
   },
   "examples": [
    [
     "Soy de Madrid.",
     "I am from Madrid."
    ],
    [
     "Ella es médica.",
     "She is a doctor."
    ],
    [
     "Somos amigos.",
     "We are friends."
    ]
   ]
  },
  {
   "slug": "article_gender",
   "level": "A1",
   "title": {
    "en": "Articles and gender",
    "ar": "أدوات التعريف والتذكير والتأنيث"
   },
   "explanation": {
    "en": "Every Spanish noun is masculine or feminine. Use el/un with masculine nouns (often ending in -o) and la/una with feminine nouns (often ending in -a). Plural: los/las, unos/unas.",
    "ar": "كل اسم في الإسبانية مذكر أو مؤنث. استخدم el/un مع المذكر (وغالبًا ينتهي بـ -o) وla/una مع المؤنث (وغالبًا ينتهي بـ -a). وفي الجمع: los/las وunos/unas."
   },
   "examples": [
    [
     "el libro",
     "the book"
    ],
    [
     "la mesa",
     "the table"
    ],
    [
     "unas casas",
     "some houses"
    ]
   ]
  },
  {
   "slug": "present_regular_ar",
   "level": "A1",
   "title": {
    "en": "Present tense of -ar verbs",
    "ar": "المضارع للأفعال المنتهية بـ -ar"
   },
   "explanation": {
    "en": "Remove -ar and add -o, -as, -a, -amos, -áis, -an. Hablar → hablo, hablas, habla, hablamos, habláis, hablan.",
    "ar": "احذف -ar وأضف -o، -as، -a، -amos، -áis، -an. مثال: hablar ← hablo، hablas، habla، hablamos، habláis، hablan."
   },
   "examples": [
    [
     "Hablo español.",
     "I speak Spanish."
    ],
    [
     "¿Trabajas aquí?",
     "Do you work here?"
    ],
    [
     "Ellos estudian mucho.",
     "They study a lot."
    ]
   ]
  },
  {
   "slug": "gustar",
   "level": "A1",
   "title": {
    "en": "Saying what you like with gustar",
    "ar": "التعبير عمّا تحبه بالفعل gustar"
   },
   "explanation": {
    "en": "Gustar agrees with the thing that is liked: me gusta + singular noun or a verb, me gustan + plural noun. The person who likes it is shown with me, te, le, nos, os, les.",
    "ar": "يتطابق الفعل gustar مع الشيء المحبوب: me gusta مع المفرد أو الفعل، وme gustan مع الجمع. ويُعبَّر عن الشخص بالضمائر me، te، le، nos، os، les."
   },
   "examples": [
    [
     "Me gusta el café.",
     "I like coffee."
    ],
    [
     "Nos gustan los libros.",
     "We like books."
    ],
    [
     "¿Te gusta bailar?",
     "Do you like dancing?"
    ]
   ]
  }
 ],
