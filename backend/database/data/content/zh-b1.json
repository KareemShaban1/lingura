 "topics": [
  {
   "slug": "le_completed",
   "level": "B1",
   "title": {
    "en": "了 for completed actions and change",
    "ar": "了 للأفعال المكتملة والتغيّر"
   },
   "explanation": {
    "en": "Put 了 after a verb for a completed action (我买了一本书), and at the end of a sentence for a new situation (下雨了 — it's started raining). Negate completed actions with 没 and no 了: 我没去.",
    "ar": "تُوضع 了 بعد الفعل للدلالة على فعل مكتمل (我买了一本书)، وفي آخر الجملة للدلالة على وضع جديد (下雨了 — بدأ المطر). ويُنفى الفعل المكتمل بـ 没 دون 了: 我没去."
   },
   "examples": [
    [
     "我昨天买了一本书。",
     "I bought a book yesterday."
    ],
    [
     "下雨了。",
     "It's started raining."
    ],
    [
     "他没去上班。",
     "He didn't go to work."
    ]
   ]
  },
  {
   "slug": "guo_experience",
   "level": "B1",
   "title": {
    "en": "过 for experiences",
    "ar": "过 للتعبير عن التجارب"
   },
   "explanation": {
    "en": "Verb + 过 says you have done something at some time (an experience): 我去过北京 — I have been to Beijing. Negate with 没 + verb + 过: 我没吃过烤鸭.",
    "ar": "الفعل + 过 يعني أنك قمت بالشيء في وقت ما (تجربة): 我去过北京 — زرت بكين من قبل. والنفي بـ 没 + الفعل + 过: 我没吃过烤鸭."
   },
   "examples": [
    [
     "我去过上海两次。",
     "I have been to Shanghai twice."
    ],
    [
     "你吃过饺子吗？",
     "Have you ever eaten dumplings?"
    ],
    [
     "我没看过这个电影。",
     "I have never seen this film."
    ]
   ]
  },
  {
   "slug": "comparison_bi",
   "level": "B1",
   "title": {
    "en": "Comparing with 比",
    "ar": "المقارنة بـ 比"
   },
   "explanation": {
    "en": "A 比 B + adjective: 今天比昨天冷 (today is colder than yesterday). Add the difference after the adjective: 他比我高一点儿. Negate with 没有: 我没有他高.",
    "ar": "A 比 B + صفة: 今天比昨天冷 (اليوم أبرد من أمس). ويُضاف مقدار الفرق بعد الصفة: 他比我高一点儿. والنفي بـ 没有: 我没有他高."
   },
   "examples": [
    [
     "今天比昨天冷。",
     "Today is colder than yesterday."
    ],
    [
     "他比我高一点儿。",
     "He's a bit taller than me."
    ],
    [
     "我的房间没有你的大。",
     "My room isn't as big as yours."
    ]
   ]
  },
  {
   "slug": "ba_construction",
   "level": "B1",
   "title": {
    "en": "The 把 construction",
    "ar": "تركيب 把"
   },
   "explanation": {
    "en": "把 puts the object before the verb to say what happens to it; the verb needs a result or complement: 请把门关上 (please close the door), 我把作业做完了 (I finished the homework).",
    "ar": "يُقدِّم 把 المفعول به قبل الفعل للتعبير عمّا يحدث له، ويحتاج الفعل إلى نتيجة أو مُكمِّل: 请把门关上 (أغلق الباب من فضلك)، 我把作业做完了 (أنهيت الواجب)."
   },
   "examples": [
    [
     "请把门关上。",
     "Please close the door."
    ],
    [
     "我把作业做完了。",
     "I've finished the homework."
    ],
    [
     "他把书放在桌子上了。",
     "He put the book on the table."
    ]
   ]
  }
 ],
