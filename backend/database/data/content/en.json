{
 "language": "en",
 "topics": [
  {
   "slug": "verb_to_be",
   "level": "A1",
   "title": {
    "en": "The verb to be (present)",
    "ar": "فعل الكينونة to be في المضارع"
   },
   "explanation": {
    "en": "Use am, is and are to say who or what someone is, where they are from and how they are: I am, you are, he/she/it is, we are, they are. Short forms: I'm, you're, she's.",
    "ar": "استخدم am وis وare لتقول من هو الشخص ومن أين هو وكيف حاله: I am وyou are وhe/she/it is وwe are وthey are. الصيغ المختصرة: I'm وyou're وshe's."
   },
   "examples": [
    [
     "I am from Egypt.",
     "أنا من مصر."
    ],
    [
     "She is a doctor.",
     "هي طبيبة."
    ],
    [
     "We are friends.",
     "نحن أصدقاء."
    ]
   ]
  },
  {
   "slug": "articles",
   "level": "A1",
   "title": {
    "en": "Articles: a, an, the",
    "ar": "أدوات التنكير والتعريف a وan وthe"
   },
   "explanation": {
    "en": "Use a before consonant sounds and an before vowel sounds for one thing mentioned for the first time. Use the for something specific or already known. There is no article before most plural or uncountable nouns in general statements.",
    "ar": "استخدم a قبل الأصوات الساكنة وan قبل الأصوات المتحركة عند ذكر شيء واحد لأول مرة. واستخدم the للشيء المحدد أو المعروف. لا نستخدم أداة قبل معظم أسماء الجمع أو الأسماء غير المعدودة في العبارات العامة."
   },
   "examples": [
    [
     "a book, an apple",
     "كتاب، تفاحة"
    ],
    [
     "The sun is hot.",
     "الشمس حارة."
    ],
    [
     "I like coffee.",
     "أحب القهوة."
    ]
   ]
  },
  {
   "slug": "present_simple",
   "level": "A1",
   "title": {
    "en": "Present simple",
    "ar": "المضارع البسيط"
   },
   "explanation": {
    "en": "Use the present simple for habits and facts. Add -s or -es after he, she and it: I work → she works, I study → he studies. Questions and negatives use do/does: Do you work? She doesn't work.",
    "ar": "يُستخدم المضارع البسيط للعادات والحقائق. أضف -s أو -es مع he وshe وit: I work ← she works، وI study ← he studies. وفي السؤال والنفي نستخدم do/does."
   },
   "examples": [
    [
     "She works in a shop.",
     "هي تعمل في متجر."
    ],
    [
     "He studies at night.",
     "هو يدرس في الليل."
    ],
    [
     "Do you speak English?",
     "هل تتكلم الإنجليزية؟"
    ]
   ]
  },
  {
   "slug": "like_ing",
   "level": "A1",
   "title": {
    "en": "Talking about likes: like + -ing",
    "ar": "التعبير عمّا تحبه: like مع -ing"
   },
   "explanation": {
    "en": "Use like + noun or like + verb-ing to talk about things you enjoy: I like coffee. I like reading. With he/she/it use likes; for negatives use don't/doesn't like.",
    "ar": "استخدم like مع اسم أو مع الفعل المنتهي بـ -ing للتعبير عمّا تستمتع به. ومع he/she/it نستخدم likes، وفي النفي don't/doesn't like."
   },
   "examples": [
    [
     "I like reading.",
     "أحب القراءة."
    ],
    [
     "She doesn't like tea.",
     "هي لا تحب الشاي."
    ],
    [
     "Do you like big cities?",
     "هل تحب المدن الكبيرة؟"
    ]
   ]
  }
 ],
