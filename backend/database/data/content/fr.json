 "language": "fr",
 "topics": [
  {
   "slug": "etre_present",
   "level": "A1",
   "title": {
    "en": "The verb être (present)",
    "ar": "الفعل être في المضارع"
   },
   "explanation": {
    "en": "Use être to say who someone is, where they are from and to describe them. Forms: je suis, tu es, il/elle est, nous sommes, vous êtes, ils/elles sont.",
    "ar": "يُستخدم الفعل être للتعريف بالشخص وبلده ووصفه. تصريفه: je suis، tu es، il/elle est، nous sommes، vous êtes، ils/elles sont."
   },
   "examples": [
    [
     "Je suis de Tunis.",
     "I am from Tunis."
    ],
    [
     "Elle est médecin.",
     "She is a doctor."
    ],
    [
     "Nous sommes amis.",
     "We are friends."
    ]
   ]
  },
  {
   "slug": "article_gender",
   "level": "A1",
   "title": {
    "en": "Articles and gender",
    "ar": "أدوات التعريف والتذكير والتأنيث"
   },
   "explanation": {
    "en": "French nouns are masculine or feminine. Use le/un with masculine nouns and la/une with feminine nouns; before a vowel, le and la become l'. Plural: les, des.",
    "ar": "الأسماء الفرنسية مذكرة أو مؤنثة. استخدم le/un مع المذكر وla/une مع المؤنث، وقبل حرف متحرك تصبح le وla ‏l'. وفي الجمع: les وdes."
   },
   "examples": [
    [
     "le livre",
     "the book"
    ],
    [
     "la maison",
     "the house"
    ],
    [
     "l'eau",
     "the water"
    ]
   ]
  },
  {
   "slug": "present_er",
   "level": "A1",
   "title": {
    "en": "Present tense of -er verbs",
    "ar": "المضارع للأفعال المنتهية بـ -er"
   },
   "explanation": {
    "en": "Remove -er and add -e, -es, -e, -ons, -ez, -ent. Parler → je parle, tu parles, il parle, nous parlons, vous parlez, ils parlent. The -e, -es and -ent endings are silent.",
    "ar": "احذف -er وأضف -e، -es، -e، -ons، -ez، -ent. مثال: parler ← je parle، tu parles، il parle، nous parlons، vous parlez، ils parlent. والنهايات -e و-es و-ent لا تُنطق."
   },
   "examples": [
    [
     "Je parle français.",
     "I speak French."
    ],
    [
     "Tu travailles ici ?",
     "Do you work here?"
    ],
    [
     "Ils étudient beaucoup.",
     "They study a lot."
    ]
   ]
  },
  {
   "slug": "aimer",
   "level": "A1",
   "title": {
    "en": "Saying what you like with aimer",
    "ar": "التعبير عمّا تحبه بالفعل aimer"
   },
   "explanation": {
    "en": "Use aimer + definite article + noun (j'aime le café) or aimer + infinitive (j'aime lire). In the negative, keep the definite article: je n'aime pas le thé.",
    "ar": "استخدم aimer مع أداة التعريف والاسم (j'aime le café) أو مع المصدر (j'aime lire). وفي النفي تبقى أداة التعريف: je n'aime pas le thé."
   },
   "examples": [
    [
     "J'aime le café.",
     "I like coffee."
    ],
    [
     "Nous aimons les livres.",
     "We like books."
    ],
    [
     "Elle n'aime pas le thé.",
     "She doesn't like tea."
    ]
   ]
  }
 ],
